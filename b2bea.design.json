      "b2bea-search",
      "b2bea-select",
      "b2bea-textarea",
      "b2bea-checkbox",
      "b2bea-radio",
      "b2bea-toggle",
      "b2bea-slider"
    ],
    "navigation": [
      "b2bea-tabs",
      "b2bea-tabs__list",
