      "b2bea-alert",
      "b2bea-alert--error",
      "b2bea-stat-strip",
      "b2bea-stat-strip__item",
      "b2bea-stat-strip__label",
      "b2bea-stat-strip__value",
      "b2bea-persona-selector",
      "b2bea-persona-selector__icon",
      "b2bea-persona-selector__item",
      "b2bea-persona-selector__label",
      "b2bea-persona-selector__sublabel",
      "b2bea-people-card",
      "b2bea-people-card__avatar",
      "b2bea-people-card__name",
      "b2bea-people-card__role",
      "b2bea-people-card__tagline",
      "b2bea-testimonial",
      "b2bea-testimonial__attribution",
      "b2bea-testimonial__name",
      "b2bea-testimonial__photo",
      "b2bea-testimonial__quote",
      "b2bea-testimonial__role",
      "b2bea-resource-card",
      "b2bea-resource-card__category",
      "b2bea-resource-card__excerpt",
      "b2bea-resource-card__footer",
      "b2bea-resource-card__media",
      "b2bea-resource-card__title",
      "b2bea-partner-card",
      "b2bea-partner-card__excerpt",
      "b2bea-partner-card__footer",
      "b2bea-partner-card__header",
      "b2bea-partner-card__logo",
      "b2bea-partner-card__tags",
      "b2bea-partner-card__title",
      "b2bea-event-list",
      "b2bea-event-card",
      "b2bea-event-card__body",
      "b2bea-event-card__date",
      "b2bea-event-card__day",
      "b2bea-event-card__excerpt",
      "b2bea-event-card__header",
      "b2bea-event-card__media",
      "b2bea-event-card__meta",
      "b2bea-event-card__month",
      "b2bea-event-card__organizer",
      "b2bea-event-card__tags",
      "b2bea-event-card__title",
      "b2bea-event-card__year"
    ],
    "app": [
      "b2bea-app-shell",
      "b2bea-app-topbar",
      "b2bea-app-topbar__actions",
      "b2bea-app-topbar__brand",
      "b2bea-app-topbar__menu-toggle",
      "b2bea-app-topbar__search",
      "b2bea-app-sidebar",
      "b2bea-app-sidebar__link",
      "b2bea-app-sidebar__link--active",
      "b2bea-app-sidebar__nav",
