    ],
    "brand": [
      "b2bea-logo",
      "b2bea-logo--horizontal",
      "b2bea-logo--stacked"
    ],
    "icons": [
      "b2bea-icon",
      "b2bea-icon--lg",
      "b2bea-icon--xl"
    ]
  },
  "iconography": {
    "source": "Lucide (https://lucide.dev)",
    "license": "ISC",
    "spritePath": "icons/lucide/sprite.svg",
    "documentation": "icons/README.md",
    "available": [
      "search",
      "menu",
      "x",
      "chevron-left",
      "chevron-right",
      "chevron-down",
      "check",
      "alert-triangle",
      "info",
      "user",
      "users",
      "calendar",
      "external-link"
    ]
  },
  "designerReviewPack": [
    "designer-review/designer-brief.md",
    "designer-review/visual-inventory.md",
    "designer-review/component-state-matrix.md",
    "designer-review/page-family-checklist.md",
    "designer-review/brand-assets.html",
    "designer-review/design-board.html"
  ],
  "metadataContract": {
    "seo": [
      "meta title",
      "meta description",
      "canonical URL",
      "index/noindex flag",
      "robots behavior",
      "slug",
      "H1",
      "primary topic/category",
      "structured data type where applicable",
      "sitemap inclusion flag",
      "redirect rule when URL changes"
    ],
    "geo": [
      "LLM answer summary",
      "entity/topic tags",
      "audience",
      "industry/category context",
      "key facts",
      "source/author attribution",
      "last reviewed date",
      "content freshness rule",
      "FAQ/question-answer fields where applicable",
      "citation/source fields where applicable"
    ],
    "social": [
      "Open Graph title",
      "Open Graph description",
      "Open Graph image",
      "Twitter/X card type",
      "social share image alt text",
      "LinkedIn-safe summary",
      "fallback image by page family"
    ]
  },
  "forbiddenPatterns": [
    "oversized standard page titles outside approved hero contexts",
    "legacy Hanken Grotesk on target Lovable pages",
    "negative letter spacing in controls or standard page headings",
    "mixed field radii and one-off form styles",
    "marketing-scale heroes inside admin, portal, profile, or workspace surfaces",
    "cards nested inside cards",
    "unstyled browser default form controls",
    "custom pages without SEO, GEO, social, and analytics metadata",
    "public practitioner company profile pages in V1",
    "insufficient contrast between any declared color pair (L1) or between any known component composition (L2)"
  ],
  "qualityBar": [
    "Every in-scope page has a recognizable Lovable header or operational shell.",
    "Fields, search, selects, filters, buttons, pills, and cards match the token contract.",
    "Standard page titles use clamp(2.25rem, 4vw, 3.75rem).",
    "Admin and portal surfaces are compact and work-focused.",
    "No public page publishes without SEO, GEO, social, indexing, and analytics metadata.",
    "Mobile text wraps without overlap or horizontal scrolling.",
    "Official B2BEA logos are used from this repo or Brett's Cloudflare account only."
  ],
  "audit": {
    "scripts": [
      "checks/audit-b2bea.js",
      "checks/audit-contrast.mjs",
      "checks/audit-a11y.mjs"
    ],
    "checks": [
      "legacy Hanken Grotesk references are reported (audit-b2bea.js)",
      "negative letter-spacing is reported (audit-b2bea.js)",
      "marketing-scale hero clamp is allowed only in files that declare the b2bea:exception=home_hero marker (audit-b2bea.js)",
      "L1: every token in b2bea.css :root matches its declaration in tokens.colors (audit-contrast.mjs)",
      "L1: every pair in audit.contrastPairs meets its WCAG threshold (audit-contrast.mjs)",
      "L2: every HTML page has lang, exactly one h1, non-skipping heading order, alt on every img, accessible name on icon-only buttons/links, label on every form field, and the four semantic landmarks (audit-a11y.mjs)",
      "L2: every element with a known b2bea-* class composition resolves to a color pair that passes 3:1 (audit-a11y.mjs)"
    ],
    "thresholds": {
      "text": 4.5,
      "large-text": 3.0,
      "ui-state": 3.0,
      "focus-ring": 3.0,
      "perElementComposition": 3.0
    },
    "contrastPairs": [
      { "fg": "text", "bg": "background", "kind": "text", "reason": "Body text on page background" },
      { "fg": "text", "bg": "surface", "kind": "text", "reason": "Body text on tinted surface" },
      { "fg": "text", "bg": "card", "kind": "text", "reason": "Body text on card surface" },
      { "fg": "muted", "bg": "background", "kind": "text", "reason": "Muted text on page background" },
      { "fg": "muted", "bg": "surface", "kind": "text", "reason": "Muted text on tinted surface" },
      { "fg": "muted", "bg": "card", "kind": "text", "reason": "Muted text on card surface" },
      { "fg": "primary", "bg": "background", "kind": "text", "reason": "Primary text / link / outline-button label on page" },
      { "fg": "primary", "bg": "card", "kind": "text", "reason": "Primary text on card surface" },
      { "fg": "inverse", "bg": "primary", "kind": "text", "reason": "Inverse text on navy (hero, primary button label, footer)" },
      { "fg": "inverse", "bg": "primaryHover", "kind": "text", "reason": "Primary button label on hover fill" },
      { "fg": "inverse", "bg": "accent", "kind": "large-text", "reason": "Accent CTA button label (14px bold; WCAG large-text bar applies)" },
      { "fg": "inverse", "bg": "accentHover", "kind": "large-text", "reason": "Accent CTA button label on hover fill" },
      { "fg": "primary", "bg": "primaryHover", "kind": "ui-state", "reason": "Primary button default vs hover affordance" },
      { "fg": "accent", "bg": "accentHover", "kind": "ui-state", "minRatio": 1.5, "reason": "Accent button default vs hover. Honest constraint: the brand's mid-luminance coral cannot reach the WCAG 1.4.11 strict 3:1 state-change contrast via a fill-only shift while keeping white text readable on the hover fill (the two are mutually exclusive: 3:1 darker pushes the hover into deep-burgundy territory that loses the coral identity; 3:1 lighter pushes into pale-peach territory where white text fails). Chosen tradeoff is a clearly-perceptible 1.5:1 minimum (deeper, more saturated coral on hover — ~1.7:1 actual). Floor is 1.5 to keep the audit catching hovers that drift back below human-perceptible threshold." },
      { "fg": "success", "bg": "background", "kind": "text", "reason": "Success-state text (success toast, validation pass)" },
      { "fg": "warning", "bg": "background", "kind": "text", "reason": "Warning-state text (warning toast, validation caution)" },
      { "fg": "inverse", "bg": "success", "kind": "large-text", "reason": "Inverse text on success-filled chips/buttons" },
      { "fg": "inverse", "bg": "warning", "kind": "large-text", "reason": "Inverse text on warning-filled chips/buttons" }
    ]
  }
}
