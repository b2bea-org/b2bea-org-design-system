{
  "name": "B2BEA.org Lovable Design System",
  "version": "0.1.0",
  "purpose": "AI-executable design contract for the B2BEA.org rebuild and Lovable-era page system.",
  "css": "b2bea.css",
  "registers": {
    "public_standard": {
      "useFor": [
        "non-home public pages",
        "directory pages",
        "topic pages",
        "academy pages",
        "events pages",
        "jobs pages",
        "survey and form landing pages"
      ],
      "mood": "clear, trusted, structured, practitioner-focused",
      "requiredSignals": [
        "blue page header with clear title",
        "short useful subtitle when needed",
        "search/filter toolbar where discovery is expected",
        "consistent cards, pills, fields, and empty states"
      ],
      "typography": {
        "display": "Open Sans",
        "body": "Open Sans",
        "ui": "Open Sans",
        "machine": "JetBrains Mono"
      },
      "heroException": {
        "name": "home_hero",
        "marker": "<!-- b2bea:exception=home_hero -->",
        "useFor": ["home page only"],
        "allowedClamp": "clamp(3rem, 7vw, 6rem)",
        "appliesTo": "b2bea-page-hero--home",
        "rule": "The marketing-scale hero clamp is permitted only in files that declare the marker; the audit fails the build if it appears anywhere else."
      }
    },
    "operational": {
      "useFor": [
        "B2BEA Admin",
        "member dashboard and profile",
        "vendor management portal",
        "company workspace",
        "account and auth surfaces"
      ],
      "mood": "compact, calm, production, work-focused",
      "requiredSignals": [
        "current state",
        "owner or account context",
        "clear next action",
        "status pills and lifecycle state",
        "error, loading, and empty states"
      ],
      "typography": {
        "display": "Open Sans",
        "body": "Open Sans",
        "ui": "Open Sans",
        "machine": "JetBrains Mono"
      }
    },
    "custom_html": {
      "useFor": [
        "custom landing pages",
        "custom resources",
        "sponsored campaign pages",
        "special conversion pages"
      ],
      "mood": "custom but still governed",
      "requiredSignals": [
        "declared owner",
        "declared route",
        "metadata contract",
        "analytics hook",
        "approved logo usage"
      ],
      "typography": {
        "default": "Open Sans unless exception is approved"
      }
    }
  },
  "tokens": {
    "colors": {
      "primary": "#00196C",
      "primaryHover": "#4D6CDB",
      "accent": "#EB5444",
      "accentHover": "#B0382A",
      "background": "#FFFFFF",
      "surface": "#F5F5F5",
      "card": "#FFFFFF",
      "border": "#E0E3EA",
      "text": "#1A1A1A",
      "muted": "#647085",
      "inverse": "#FFFFFF",
      "success": "#1F7A4D",
      "warning": "#8A5A00"
    },
    "fontRoles": {
      "display": "--b2bea-font-display",
      "body": "--b2bea-font-body",
      "ui": "--b2bea-font-ui",
      "machine": "--b2bea-font-mono"
    },
    "componentPrefix": "b2bea-",
    "radius": {
      "default": "0.75rem",
      "small": "0.5rem",
      "pill": "999px"
    },
    "controls": {
      "height": "2.5rem",
      "fontSize": "0.875rem",
      "focusRing": "0 0 0 3px rgba(0, 25, 108, 0.12)"
    }
  },
  "components": {
    "layout": [
      "b2bea-container",
      "b2bea-page",
      "b2bea-section",
      "b2bea-section--compact",
      "b2bea-page-hero",
      "b2bea-page-hero--home",
      "b2bea-page-hero__inner",
      "b2bea-marketing-nav",
